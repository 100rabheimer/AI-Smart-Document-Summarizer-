# ==============================================================================
# DocMind - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key

# Database (PostgreSQL with pgvector)
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind_secret
POSTGRES_DB=docmind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docmind:docmind_secret@localhost:5432/docmind_db

# Cache & Limiter (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# OAuth 2.0 (Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google

# Frontend URLs (CORS & Redirects)
FRONTEND_URL=http://localhost:5173

# AI & LLM Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768
CHAT_MODEL=gemini-1.5-flash

# Local Ollama Configuration (Fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Document Upload & Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
